@{
    ViewData["Title"] = "Quiniela Mundial 2026";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HERO -->
<section class="landing-hero">
    <div class="landing-hero-bar"></div>
    <div class="landing-hero-blob landing-hero-blob-1"></div>
    <div class="landing-hero-blob landing-hero-blob-2"></div>
    <div class="landing-hero-blob landing-hero-blob-3"></div>
    <div class="landing-hero-inner">
        <img src="/img/wc2026-logo.png" alt="FIFA World Cup 2026" class="landing-hero-logo-img" />
        <span class="landing-eyebrow">FIFA WORLD CUP 2026</span>
        <h1 class="landing-h1">QUINIELA MUNDIAL 2026</h1>
        <p class="landing-hero-sub">competencia que une a todo el equipo</p>
        <div class="landing-hero-btns">
            <a href="/Account/Register" class="btn landing-btn-primary">Registrarme ahora</a>
            <a href="/Account/Login" class="btn landing-btn-outline">Ya tengo cuenta</a>
        </div>
    </div>
</section>

<!-- INTRODUCCIÓN -->
<section class="landing-intro">
    <p>
        Durante más de un mes, predice los resultados del Mundial de Fútbol 2026,
        compite con tus compañeros y demuestra quién sabe más de fútbol.
        Una oportunidad de conectar con toda la operación.
    </p>
</section>

<!-- BANNER CON JUGADORES -->
<section class="landing-banner-section">
    <div class="landing-banner-bg"></div>
    <div class="landing-banner-overlay"></div>
    <div class="landing-banner-content">
        <span class="landing-banner-eyebrow">48 selecciones · 104 partidos · 3 países</span>
        <h2 class="landing-banner-title">El mundo entero<br>en un solo torneo</h2>
        <p class="landing-banner-sub">
            Del 11 de junio al 19 de julio de 2026.<br>
            Predice cada resultado y sube al top de la clasificación.
        </p>
        <a href="/Account/Register" class="landing-banner-btn">Unirme ahora</a>
    </div>
</section>

<!-- 4 PASOS -->
<section class="landing-steps">
    <div class="landing-inner">
        <div class="landing-section-label">CÓMO FUNCIONA</div>
        <h2 class="landing-section-title">4 PASOS SENCILLOS</h2>
        <div class="landing-steps-grid">
            <div class="landing-step-card" style="border-top-color:var(--wc-red)">
                <div class="landing-step-num" style="color:var(--wc-red)">1</div>
                <div class="landing-step-title">Regístrate</div>
                <p class="landing-step-desc">
                    Inscríbete con tu correo y completa el pago inicial de $20.
                    El monto íntegro se acumula en la bolsa de premios.
                </p>
            </div>
            <div class="landing-step-card" style="border-top-color:var(--wc-blue2)">
                <div class="landing-step-num" style="color:var(--wc-blue2)">2</div>
                <div class="landing-step-title">Predice cada partido</div>
                <p class="landing-step-desc">
                    Ingresa tu pronóstico antes de cada fecha.
                    5 pts por marcador exacto — 2 pts por resultado correcto.
                </p>
            </div>
            <div class="landing-step-card" style="border-top-color:var(--wc-lime)">
                <div class="landing-step-num" style="color:var(--wc-lime)">3</div>
                <div class="landing-step-title">Sube en la clasificación</div>
                <p class="landing-step-desc">
                    Acumula puntos y compite contra todos tus compañeros
                    en la tabla general en tiempo real.
                </p>
            </div>
            <div class="landing-step-card" style="border-top-color:var(--wc-gold)">
                <div class="landing-step-num" style="color:var(--wc-gold)">4</div>
                <div class="landing-step-title">Gana tu parte de la bolsa</div>
                <p class="landing-step-desc">
                    Al cerrar las fases, el premio acumulado
                    se distribuye entre los tres mejores.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- FASE DE ELIMINACIÓN -->
<section class="landing-elim">
    <div class="landing-elim-inner">
        <span class="landing-badge">FASE DE ELIMINACIÓN DIRECTA</span>
        <h2>LOS PUNTOS SE REINICIAN</h2>
        <p>
            Al inicio de los octavos de final todos parten de cero.
            Cualquiera puede ganar hasta el último partido.
        </p>
    </div>
</section>

<!-- DISTRIBUCIÓN DE PREMIOS -->
<section class="landing-prizes">
    <div class="landing-inner">
        <div class="landing-section-label">BOLSA DE PREMIOS</div>
        <h2 class="landing-section-title">DISTRIBUCIÓN DE PREMIOS</h2>
        <div class="landing-prizes-grid">
            <div class="landing-prize-card" style="border-color:#C9A84C">
                <div class="landing-prize-pct" style="color:#C9A84C">60%</div>
                <div class="landing-prize-place">1er Lugar</div>
            </div>
            <div class="landing-prize-card" style="border-color:#9CA3AF">
                <div class="landing-prize-pct" style="color:#9CA3AF">30%</div>
                <div class="landing-prize-place">2do Lugar</div>
            </div>
            <div class="landing-prize-card" style="border-color:#CD7F32">
                <div class="landing-prize-pct" style="color:#CD7F32">10%</div>
                <div class="landing-prize-place">3er Lugar</div>
            </div>
        </div>
    </div>
</section>

<!-- PAÍSES SEDE -->
<section class="landing-venues">
    <div class="landing-inner">
        <div class="landing-section-label" style="color:rgba(255,255,255,.35)">FIFA WORLD CUP 2026</div>
        <h2 class="landing-section-title" style="color:#fff">PAÍSES SEDE</h2>
        <div class="landing-venues-grid">
            <div class="landing-venue-card" style="border-top-color:var(--wc-red)">
                <div class="landing-venue-name">USA</div>
                <div class="landing-venue-sub">Sede FIFA 2026</div>
            </div>
            <div class="landing-venue-card" style="border-top-color:var(--wc-green)">
                <div class="landing-venue-name">México</div>
                <div class="landing-venue-sub">Sede FIFA 2026</div>
            </div>
            <div class="landing-venue-card" style="border-top-color:var(--wc-blue)">
                <div class="landing-venue-name">Canadá</div>
                <div class="landing-venue-sub">Sede FIFA 2026</div>
            </div>
        </div>
    </div>
</section>

<!-- CTA FINAL -->
<section class="landing-cta">
    <h2>¿LISTO PARA COMPETIR?</h2>
    <p>Únete ahora y empieza a predecir desde la primera fecha</p>
    <a href="/Account/Register" class="landing-btn-white">COMENZAR — REGISTRARME</a>
</section>
