@{ ViewData["Title"] = "Nueva contraseña"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="auth-wrap">
  <!-- Panel izquierdo — fondo negro con patrón de cancha -->
  <div class="auth-left">
    <div class="auth-left-bg">2026</div>
    <div class="auth-left-content">
      <div class="auth-left-kicker">
        <div class="auth-left-kicker-line"></div>
        FIFA World Cup 2026
      </div>
      <div class="auth-left-title">
        Quiniela<span>Mundial</span>
      </div>
      <p class="auth-left-sub">USA · Canada · Mexico — 11 Jun · 19 Jul</p>
      <div class="auth-left-features">
        <div class="auth-feature">Predice resultados en tiempo real</div>
        <div class="auth-feature">Compite con toda la operación</div>
        <div class="auth-feature">Sigue la clasificación en vivo</div>
      </div>
    </div>
  </div>

  <!-- Panel derecho -->
  <div class="auth-right">
    <div class="auth-form-wrap">
      <div class="auth-form-title">Nueva contraseña</div>
      <p class="auth-form-sub">Ingresa tu nueva contraseña</p>

      <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@ViewBag.Token" />

        <div class="field">
          <label for="newPassword">Nueva contraseña</label>
          <input id="newPassword" name="newPassword" type="password" class="input"
                 placeholder="••••••••" autocomplete="new-password" />
        </div>
        <div class="field">
          <label for="confirmPassword">Confirmar contraseña</label>
          <input id="confirmPassword" name="confirmPassword" type="password" class="input"
                 placeholder="••••••••" autocomplete="new-password" />
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg"
                style="margin-top:.6rem">
          Guardar contraseña
        </button>
      </form>
    </div>
  </div>
</div>
