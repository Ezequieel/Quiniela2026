@{ ViewData["Title"] = "Recuperar contraseña"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="auth-wrap">
  <!-- Panel izquierdo — fondo negro con patrón de cancha -->
  <div class="auth-left">
    <div class="auth-left-bg">2026</div>
    <div class="auth-left-content">
      <div class="auth-left-kicker">
        <div class="auth-left-kicker-line"></div>
        FIFA World Cup 2026
      </div>
      <div class="auth-left-title">
        Quiniela<span>Mundial</span>
      </div>
      <p class="auth-left-sub">USA · Canada · Mexico — 11 Jun · 19 Jul</p>
      <div class="auth-left-features">
        <div class="auth-feature">Predice resultados en tiempo real</div>
        <div class="auth-feature">Compite con toda la operación</div>
        <div class="auth-feature">Sigue la clasificación en vivo</div>
      </div>
    </div>
  </div>

  <!-- Panel derecho -->
  <div class="auth-right">
    <div class="auth-form-wrap">
      <div class="auth-form-title">Recuperar contraseña</div>
      <p class="auth-form-sub">Ingresa tu correo registrado</p>

      <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <div class="field">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" class="input"
                 placeholder="correo@empresa.com" autocomplete="email" />
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg"
                style="margin-top:.6rem">
          Enviar enlace
        </button>
      </form>

      <p class="auth-link">
        <a asp-action="Login">Volver al login</a>
      </p>
    </div>
  </div>
</div>
