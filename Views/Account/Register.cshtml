@model RegisterVm
@{ ViewData["Title"] = "Crear cuenta"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="auth-wrap">
  <!-- Panel izquierdo -->
  <div class="auth-left">
    <div class="auth-left-content">
      <span class="auth-left-logo">🏆</span>
      <div class="auth-left-title">Únete a la<br /><span>Quiniela</span></div>
      <p class="auth-left-sub">Crea tu cuenta y empieza a predecir</p>
      <div class="auth-left-features">
        <div class="auth-feature">
          <div class="auth-feature-icon red">⚽</div>
          <span>Predice resultados de partidos reales</span>
        </div>
        <div class="auth-feature">
          <div class="auth-feature-icon gold">🥇</div>
          <span>Sube al top de la clasificación</span>
        </div>
        <div class="auth-feature">
          <div class="auth-feature-icon green">🔴</div>
          <span>Datos en vivo desde API-Football</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Panel derecho -->
  <div class="auth-right">
    <div class="auth-form-wrap">
      <h1 class="auth-form-title">Crear cuenta</h1>
      <p class="auth-form-sub">Completa el formulario para registrarte</p>

      <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="val-summary"></div>

        <div class="field">
          <label asp-for="FullName">Nombre completo</label>
          <input asp-for="FullName" class="input" placeholder="Tu nombre" autocomplete="name" />
          <span asp-validation-for="FullName" class="field-err"></span>
        </div>
        <div class="field">
          <label asp-for="Username">Nombre de usuario</label>
          <input asp-for="Username" class="input" placeholder="usuario123" autocomplete="username" />
          <span asp-validation-for="Username" class="field-err"></span>
        </div>
        <div class="field">
          <label asp-for="Email">Correo electrónico</label>
          <input asp-for="Email" class="input" placeholder="correo@empresa.com" autocomplete="email" />
          <span asp-validation-for="Email" class="field-err"></span>
        </div>
        <div class="field">
          <label asp-for="Password">Contraseña</label>
          <input asp-for="Password" class="input" type="password" placeholder="••••••••" autocomplete="new-password" />
          <span asp-validation-for="Password" class="field-err"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:.6rem">
          Crear cuenta →
        </button>
      </form>

      <p class="auth-link">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>
    </div>
  </div>
</div>
