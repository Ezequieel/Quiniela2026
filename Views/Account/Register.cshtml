@model RegisterVm
@{ ViewData["Title"] = "Crear cuenta"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="auth-wrap">
  <!-- Panel izquierdo — fondo negro con patrón de cancha -->
  <div class="auth-left">
    <div class="auth-left-bg">2026</div>
    <div class="auth-left-content">
      <div class="auth-left-kicker">
        <div class="auth-left-kicker-line"></div>
        FIFA World Cup 2026
      </div>
      <div class="auth-left-title">
        Únete<span>a la quiniela</span>
      </div>
      <p class="auth-left-sub">Registro único — todo va al premio</p>
      <div class="auth-left-features">
        <div class="auth-feature">Pago único para participar</div>
        <div class="auth-feature">Predice desde la primera fecha</div>
        <div class="auth-feature">Clasificación en tiempo real</div>
      </div>
    </div>
  </div>

  <!-- Panel derecho -->
  <div class="auth-right">
    <div class="auth-form-wrap">
      <div class="auth-form-title">Crear cuenta</div>
      <p class="auth-form-sub">Registro de participante</p>

      <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="val-summary"></div>

        <div class="field">
          <label asp-for="FullName">Nombre completo</label>
          <input asp-for="FullName" class="input"
                 placeholder="Tu nombre completo" autocomplete="name" />
          <span asp-validation-for="FullName" class="field-err"></span>
        </div>
        <div class="field">
          <label asp-for="Username">Nombre de usuario</label>
          <input asp-for="Username" class="input"
                 placeholder="usuario123" autocomplete="username" />
          <span asp-validation-for="Username" class="field-err"></span>
        </div>
        <div class="field">
          <label asp-for="Email">Correo electrónico</label>
          <input asp-for="Email" class="input"
                 placeholder="correo@empresa.com" autocomplete="email" />
          <span asp-validation-for="Email" class="field-err"></span>
        </div>
        <div class="field">
          <label asp-for="Password">Contraseña</label>
          <input asp-for="Password" class="input" type="password"
                 placeholder="••••••••" autocomplete="new-password" />
          <span asp-validation-for="Password" class="field-err"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg"
                style="margin-top:.6rem">
          Crear cuenta
        </button>
      </form>

      <p class="auth-link">
        Ya tienes cuenta — <a asp-action="Login">Iniciar sesión</a>
      </p>
    </div>
  </div>
</div>
