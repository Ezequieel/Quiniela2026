@model LoginVm
@{ ViewData["Title"] = "Iniciar sesión"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="auth-wrap">
  <!-- Panel izquierdo — fondo negro con patrón de cancha -->
  <div class="auth-left">
    <div class="auth-left-bg">2026</div>
    <div class="auth-left-content">
      <div class="auth-left-kicker">
        <div class="auth-left-kicker-line"></div>
        FIFA World Cup 2026
      </div>
      <div class="auth-left-title">
        Quiniela<span>Mundial</span>
      </div>
      <p class="auth-left-sub">USA · Canada · Mexico — 11 Jun · 19 Jul</p>
      <div class="auth-left-features">
        <div class="auth-feature">Predice resultados en tiempo real</div>
        <div class="auth-feature">Compite con toda la operación</div>
        <div class="auth-feature">Sigue la clasificación en vivo</div>
      </div>
    </div>
  </div>

  <!-- Panel derecho -->
  <div class="auth-right">
    <div class="auth-form-wrap">
      <div class="auth-form-title">Iniciar sesión</div>
      <p class="auth-form-sub">Ingresa tus credenciales</p>

      <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="val-summary"></div>

        <div class="field">
          <label asp-for="Email">Correo electrónico</label>
          <input asp-for="Email" class="input"
                 placeholder="correo@empresa.com" autocomplete="email" />
          <span asp-validation-for="Email" class="field-err"></span>
        </div>
        <div class="field">
          <label asp-for="Password">Contraseña</label>
          <input asp-for="Password" class="input" type="password"
                 placeholder="••••••••" autocomplete="current-password" />
          <span asp-validation-for="Password" class="field-err"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg"
                style="margin-top:.6rem">
          Iniciar sesión
        </button>
      </form>

      <p class="auth-link">
        Sin cuenta — <a asp-action="Register">Registrarse</a>
      </p>
    </div>
  </div>
</div>
