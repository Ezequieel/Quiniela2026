@model LoginVm
@{ ViewData["Title"] = "Iniciar sesión"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="auth-wrap auth-bg">
  <div class="auth-card">
    <div class="auth-logo">⚽</div>
    <h1 class="auth-title">Quiniela Mundial</h1>
    <p class="auth-sub">Ingresa tus credenciales para continuar</p>
    <form asp-action="Login" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="val-summary"></div>
      <div class="field">
        <label asp-for="Email">Correo electrónico</label>
        <input asp-for="Email" class="input" placeholder="correo@empresa.com" autocomplete="email" />
        <span asp-validation-for="Email" class="field-err"></span>
      </div>
      <div class="field">
        <label asp-for="Password">Contraseña</label>
        <input asp-for="Password" class="input" type="password" placeholder="••••••••" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-err"></span>
      </div>
      <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:.4rem">
        Iniciar sesión
      </button>
    </form>
    <p class="auth-link">¿No tienes cuenta? <a asp-action="Register">Regístrate aquí</a></p>
  </div>
</div>
