<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta name="theme-color" content="#1A1A1A" />
    <title>@ViewData["Title"] — Quiniela Mundial</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="~/css/mundial.css" />
</head>
<body>

@if (ViewBag.HideNav != true)
{
    <nav class="navbar">
        <div class="nav-inner">
            <a class="nav-brand" asp-controller="Home" asp-action="Index">
                Quiniela Mundial
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="nav-links">
                    <a asp-controller="Tournament" asp-action="Index">Torneos</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/Index" class="nav-admin">Admin</a>
                    }
                    <span class="nav-user">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-nav-exit">Salir</button>
                    </form>
                </div>
            }
            else
            {
                <div class="nav-links">
                    <a asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Registrarse</a>
                </div>
            }
        </div>
    </nav>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="ep-ticker">
            <span class="ep-ticker-label">Mundial 2026</span>
            <div class="ep-ticker-items">
                <span class="ep-ticker-item">11 Jun — Arranque fase de grupos</span>
                <span class="ep-ticker-sep">·</span>
                <span class="ep-ticker-item">48 selecciones · 104 partidos · 16 estadios</span>
                <span class="ep-ticker-sep">·</span>
                <span class="ep-ticker-item">Final: 19 Jul 2026, Nueva York/Nueva Jersey</span>
            </div>
        </div>
    }
}

<main class="@(ViewBag.FullWidth == true ? "app-main-full" : "app-main")">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-ok">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-err">@TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }
    @RenderBody()
</main>

@if (ViewBag.HideFooter != true)
{
    <footer class="app-footer">
        <p>QUINIELA MUNDIAL &mdash; @DateTime.Now.Year</p>
    </footer>
}

<script src="~/js/app.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
