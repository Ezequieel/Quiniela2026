<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta name="theme-color" content="#111111" />
    <title>@ViewData["Title"] — Quiniela Mundial</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Barlow+Condensed:wght@400;600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="~/css/mundial.css" />
</head>
<body>

@if (ViewBag.HideNav != true)
{
    <nav class="topbar">
        <div class="topbar-inner">
            <a class="topbar-brand" asp-controller="Home" asp-action="Index">
                Quiniela Mundial
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="topbar-nav">
                    <a asp-controller="Tournament" asp-action="Index" class="topbar-link">Torneos</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/Index" class="topbar-admin">Admin</a>
                    }
                    <span class="topbar-user">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="topbar-exit">Salir</button>
                    </form>
                </div>
            }
            else
            {
                <div class="topbar-nav">
                    <a asp-controller="Account" asp-action="Login" class="topbar-link">Iniciar sesión</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Registrarse</a>
                </div>
            }
        </div>
    </nav>
}

<main class="@(ViewBag.FullWidth == true ? "app-main-full" : "app-main")">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-ok">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-err">@TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }
    @RenderBody()
</main>

@if (ViewBag.HideFooter != true)
{
    <footer class="app-footer">
        <p>QUINIELA MUNDIAL &mdash; @DateTime.Now.Year &mdash; USA · Canadá · México</p>
    </footer>
}

<script src="~/js/app.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
