@model EditStageVm
@{ ViewData["Title"] = "Editar fase"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="page-header">
    <div>
        <a href="/Admin/Index" class="breadcrumb">← Administración</a>
        <h1>Editar fase — @Model.TournamentName</h1>
    </div>
</div>

<div class="card" style="max-width:620px">
    <form asp-action="EditStage" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TournamentId" />
        <div asp-validation-summary="All" class="val-summary"></div>

        <div class="field">
            <label asp-for="Name">Nombre de la fase</label>
            <input asp-for="Name" class="input" />
            <span asp-validation-for="Name" class="field-err"></span>
        </div>

        <div class="fields-row">
            <div class="field">
                <label asp-for="Type">Tipo</label>
                <select asp-for="Type" class="input">
                    <option value="League">Jornada de liga</option>
                    <option value="GroupStage">Fase de grupos</option>
                    <option value="RoundOf32">Treintaidosavos</option>
                    <option value="RoundOf16">Dieciseisavos</option>
                    <option value="QuarterFinal">Cuartos de final</option>
                    <option value="SemiFinal">Semifinales</option>
                    <option value="Final">Final</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="Status">Estado</label>
                <select asp-for="Status" class="input">
                    <option value="Pending">Pendiente</option>
                    <option value="Open">Abierta</option>
                    <option value="InProgress">En curso</option>
                    <option value="Finished">Finalizada</option>
                </select>
            </div>
        </div>

        <div class="fields-row">
            <div class="field">
                <label asp-for="EntryFee">Cuota ($)</label>
                <input asp-for="EntryFee" class="input" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="EntryFee" class="field-err"></span>
            </div>
            <div class="field">
                <label asp-for="OrderNum">Orden</label>
                <input asp-for="OrderNum" class="input" type="number" min="1" />
            </div>
        </div>

        <div class="field">
            <label asp-for="PredictionDeadline">Cierre de predicciones <span class="hint">Hora de El Salvador (UTC-6)</span></label>
            <input asp-for="PredictionDeadline" class="input" type="datetime-local"
                   value="@Model.PredictionDeadline.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="PredictionDeadline" class="field-err"></span>
        </div>

        <div class="field">
            <label asp-for="GroupKey">
                Clave de grupo de pago
                <span class="hint">Fases con la misma clave comparten un solo pago. Dejar vacío para pago individual.</span>
            </label>
            <input asp-for="GroupKey" class="input" placeholder="ej: grupos, eliminatorias" />
        </div>

        <div style="display:flex;gap:.5rem">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a href="/Admin/Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
