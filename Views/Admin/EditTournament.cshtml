@model EditTournamentVm
@{ ViewData["Title"] = "Editar torneo"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="page-header">
    <div>
        <a href="/Admin/Index" class="breadcrumb">← Administración</a>
        <h1>Editar torneo</h1>
    </div>
</div>

<div class="card" style="max-width:640px">
    <form asp-action="EditTournament" method="post" enctype="multipart/form-data" id="edit-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="val-summary"></div>

        <div class="section-title">Información del torneo</div>

        <div class="field">
            <label asp-for="Name">Nombre del torneo</label>
            <input asp-for="Name" class="input" />
            <span asp-validation-for="Name" class="field-err"></span>
        </div>
        <div class="field">
            <label asp-for="Description">Descripción</label>
            <input asp-for="Description" class="input" />
        </div>
        <div class="field">
            <label asp-for="Status">Estado</label>
            <select asp-for="Status" class="input">
                <option value="Draft">Borrador</option>
                <option value="Active">Activo</option>
                <option value="Finished">Finalizado</option>
            </select>
        </div>

        <div class="divider"></div>
        <div class="section-title">Imágenes</div>

        @if (!string.IsNullOrEmpty(Model.ExistingLogo))
        {
            <div style="margin-bottom:.8rem;display:flex;align-items:center;gap:.75rem">
                <img src="@Model.ExistingLogo" style="height:44px;object-fit:contain;border:1px solid var(--border);border-radius:6px;padding:4px;background:var(--g50)" />
                <span class="text-muted" style="font-size:.78rem">Logo actual</span>
            </div>
        }
        <div class="field">
            <label asp-for="LogoFile">Nuevo logo <span class="hint">Dejar vacío para mantener el actual</span></label>
            <input asp-for="LogoFile" type="file" accept="image/*" class="input-file"
                   id="logo-file" onchange="validateFile(this, 2, 'logo-err', 'logo-hint')" />
            <span class="field-hint" id="logo-hint">Tamaño máximo permitido: 2 MB</span>
            <span class="field-err" id="logo-err"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.ExistingQr))
        {
            <div style="margin-bottom:.8rem;display:flex;align-items:center;gap:.75rem">
                <img src="@Model.ExistingQr" style="height:64px;object-fit:contain;border:1px solid var(--border);border-radius:6px;padding:4px;background:#fff" />
                <span class="text-muted" style="font-size:.78rem">QR actual</span>
            </div>
        }
        <div class="field">
            <label asp-for="QrFile">Nuevo QR <span class="hint">Dejar vacío para mantener el actual</span></label>
            <input asp-for="QrFile" type="file" accept="image/*" class="input-file"
                   id="qr-file" onchange="validateFile(this, 3, 'qr-err', 'qr-hint')" />
            <span class="field-hint" id="qr-hint">Tamaño máximo permitido: 3 MB</span>
            <span class="field-err" id="qr-err"></span>
        </div>

        <div class="divider"></div>
        <div class="section-title">Configuración de pago</div>

        <div class="field">
            <label asp-for="PaymentUrl">URL alternativa de pago <span class="hint">Opcional</span></label>
            <input asp-for="PaymentUrl" class="input" placeholder="https://link.pagadito.com/..." />
            <span class="field-hint">Enlace directo si el usuario no puede escanear el QR</span>
        </div>
        <div class="field">
            <label asp-for="PaymentInfo">Instrucciones de pago</label>
            <textarea asp-for="PaymentInfo" class="input" rows="4"></textarea>
        </div>

        <div style="display:flex;gap:.5rem">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a href="/Admin/Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
function validateFile(input, maxMB, errId, hintId) {
    const errEl  = document.getElementById(errId);
    const hintEl = document.getElementById(hintId);
    errEl.textContent = '';

    if (!input.files || input.files.length === 0) return true;

    const file     = input.files[0];
    const maxBytes = maxMB * 1024 * 1024;

    if (file.size > maxBytes) {
        errEl.textContent = `El archivo seleccionado supera el tamaño máximo permitido de ${maxMB} MB.`;
        input.value = '';
        hintEl.textContent = `Tamaño máximo permitido: ${maxMB} MB`;
        hintEl.style.color = '';
        return false;
    }
    hintEl.textContent = `✓ ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
    hintEl.style.color = 'var(--green)';
    return true;
}

document.getElementById('edit-form').addEventListener('submit', function(e) {
    let valid = true;
    if (!validateFile(document.getElementById('logo-file'), 2, 'logo-err', 'logo-hint')) valid = false;
    if (!validateFile(document.getElementById('qr-file'),   3, 'qr-err',   'qr-hint'))  valid = false;
    if (!valid) e.preventDefault();
});
</script>
}
