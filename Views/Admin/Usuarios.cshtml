@model List<QuinielaApp.ViewModels.UsuarioAdminVm>
@using QuinielaApp.Helpers
@{
    ViewData["Title"] = "Usuarios registrados";
    ViewBag.FullWidth = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-hero">
    <div class="admin-hero-inner">
        <div>
            <div class="admin-hero-eyebrow">
                <a asp-action="Index" style="color:rgba(255,255,255,.6);text-decoration:none;font-size:.82rem">
                    ← Administración
                </a>
            </div>
            <h1 class="admin-hero-title">
                Usuarios <span>registrados</span>
            </h1>
            <p class="admin-hero-sub">Historial completo de participantes de la quiniela</p>
        </div>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap;align-items:center">
            <button onclick="exportarCSV()" class="btn btn-sm"
                    style="background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.8);font-family:'Barlow Condensed',sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:.08em">
                Exportar CSV
            </button>
        </div>
    </div>
</div>

<div class="app-main">

<div class="admin-stats">
    <div class="admin-stat-card stat-blue">
        <div class="admin-stat-num">@ViewBag.Total</div>
        <div class="admin-stat-lbl">Total registrados</div>
    </div>
    <div class="admin-stat-card stat-green">
        <div class="admin-stat-num">@ViewBag.Players</div>
        <div class="admin-stat-lbl">Jugadores activos</div>
    </div>
    <div class="admin-stat-card stat-red">
        <div class="admin-stat-num">@ViewBag.Admins</div>
        <div class="admin-stat-lbl">Administradores</div>
    </div>
    <div class="admin-stat-card stat-amber">
        <div class="admin-stat-num">$@ViewBag.Bolsa.ToString("N2")</div>
        <div class="admin-stat-lbl">Bolsa total recaudada</div>
    </div>
</div>

<div class="admin-section">
    <div class="admin-section-head" style="flex-wrap:wrap;gap:.6rem">
        <span class="admin-section-title">Participantes</span>
        <input id="buscar" type="text" placeholder="Buscar por nombre, usuario o correo…"
               style="flex:1;min-width:220px;max-width:360px;padding:.4rem .75rem;border-radius:6px;border:1px solid var(--border);background:var(--surf2);color:var(--text-1);font-size:.86rem;outline:none" />
    </div>

    @if (!Model.Any())
    {
        <div class="empty-box">
            <h3>Sin usuarios</h3>
            <p>Aún no hay usuarios registrados.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="lb-table admin-table" id="tablaUsuarios">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nombre completo</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Torneos</th>
                        <th>Total pagado</th>
                        <th>Fecha registro</th>
                    </tr>
                </thead>
                <tbody>
                @{ int idx = 0; }
                @foreach (var u in Model)
                {
                    idx++;
                    <tr>
                        <td style="font-size:.8rem;color:var(--text-3);font-weight:600">@idx</td>
                        <td>
                            <div style="font-weight:600;font-size:.85rem;color:var(--text-1)">@u.FullName</div>
                        </td>
                        <td style="font-size:.84rem;color:var(--text-2)">@@@u.Username</td>
                        <td style="font-size:.82rem;color:var(--text-3)">@u.Email</td>
                        <td>
                            <span class="chip chip-@(u.Role == "Admin" ? "red" : "gray")">
                                @u.Role
                            </span>
                        </td>
                        <td style="text-align:center;font-weight:600;color:var(--text-1)">@u.Torneos</td>
                        <td style="font-weight:700;@(u.PagoTotal > 0 ? "color:var(--green)" : "color:var(--text-3)")">
                            $@u.PagoTotal.ToString("N2")
                        </td>
                        <td style="font-size:.8rem;color:var(--text-3)">
                            @TimeHelper.ToSvTime(u.CreatedAt).ToString("dd/MM/yyyy HH:mm")
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

</div>@* /app-main *@

@section Scripts {
<script>
document.getElementById('buscar')?.addEventListener('input', function () {
    const q = this.value.toLowerCase();
    document.querySelectorAll('#tablaUsuarios tbody tr').forEach(tr => {
        tr.style.display = tr.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
});

function exportarCSV() {
    const rows = [
        ['#', 'Nombre', 'Usuario', 'Correo', 'Rol', 'Torneos', 'Total Pagado', 'Registro']
    ];
    document.querySelectorAll('#tablaUsuarios tbody tr').forEach(tr => {
        const cols = tr.querySelectorAll('td');
        rows.push([...cols].map(td => '"' + td.innerText.trim().replace(/"/g, '""') + '"'));
    });
    const csv = rows.map(r => r.join(',')).join('\n');
    const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'usuarios_quiniela_' + new Date().toISOString().slice(0, 10) + '.csv';
    a.click();
    URL.revokeObjectURL(url);
}
</script>
}
