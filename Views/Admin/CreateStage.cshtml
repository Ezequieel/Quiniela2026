@model CreateStageVm
@{ ViewData["Title"] = "Nueva fase"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="page-header">
    <div>
        <a href="/Admin/Index" class="breadcrumb">← Administración</a>
        <h1>Nueva fase — @Model.TournamentName</h1>
    </div>
</div>

<div class="card" style="max-width:620px">
    <form asp-action="CreateStage" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TournamentId" />
        <div asp-validation-summary="All" class="val-summary"></div>

        <div class="field">
            <label asp-for="Name">Nombre de la fase</label>
            <input asp-for="Name" class="input" placeholder="Jornada 12 / Cuartos de final" />
            <span asp-validation-for="Name" class="field-err"></span>
        </div>

        <div class="fields-row">
            <div class="field">
                <label asp-for="Type">Tipo</label>
                <select asp-for="Type" class="input">
                    <option value="League">Jornada de liga</option>
                    <option value="GroupStage">Fase de grupos</option>
                    <option value="RoundOf32">Treintaidosavos</option>
                    <option value="RoundOf16">Dieciseisavos</option>
                    <option value="QuarterFinal">Cuartos de final</option>
                    <option value="SemiFinal">Semifinales</option>
                    <option value="Final">Final</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="OrderNum">Orden</label>
                <input asp-for="OrderNum" class="input" type="number" min="1" />
                <span class="hint">Posición dentro del torneo</span>
            </div>
        </div>

        <div class="field">
            <label asp-for="ApiRound">Jornada de la API</label>
            @if (Model.AvailableRounds.Any())
            {
                <select asp-for="ApiRound" class="input"
                        asp-items="@(new SelectList(Model.AvailableRounds))">
                    <option value="">— Selecciona una jornada —</option>
                </select>
            }
            else
            {
                <input asp-for="ApiRound" class="input" placeholder="Regular Season - 38" />
                <span class="hint">Para Mundial: Group Stage - A, Round of 16, Quarter-finals...</span>
            }
            <span asp-validation-for="ApiRound" class="field-err"></span>
        </div>

        <div class="fields-row">
            <div class="field">
                <label asp-for="EntryFee">Cuota de inscripción ($)</label>
                <input asp-for="EntryFee" class="input" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="EntryFee" class="field-err"></span>
            </div>
            <div class="field">
                <label asp-for="PredictionDeadline">Cierre de predicciones <span class="hint">Hora de El Salvador (UTC-6)</span></label>
                <input asp-for="PredictionDeadline" class="input" type="datetime-local"
                       value="@Model.PredictionDeadline.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="PredictionDeadline" class="field-err"></span>
            </div>
        </div>

        <div class="field">
            <label asp-for="GroupKey">
                Clave de grupo de pago
                <span class="hint">Opcional — fases con la misma clave comparten un solo pago. Ej: "grupos" para las 3 jornadas de grupos</span>
            </label>
            <input asp-for="GroupKey" class="input" placeholder="ej: grupos, eliminatorias" />
        </div>

        <div class="field">
            <label asp-for="BannerFile">
                Banner de la fase
                <span class="hint">Opcional — imagen decorativa en la tarjeta</span>
            </label>
            <input asp-for="BannerFile" type="file" accept="image/*"
                   class="input-file" id="banner-file"
                   onchange="validateFile(this, 3, 'banner-err', 'banner-hint')" />
            <span class="field-hint" id="banner-hint">
                Recomendado: 800x200px · Tamaño máximo: 3 MB
            </span>
            <span class="field-err" id="banner-err"></span>
        </div>

        <div class="info-banner" style="margin-bottom:1rem">
            Los partidos se cargarán automáticamente desde API-Football al crear la fase.
        </div>

        <button type="submit" class="btn btn-primary">Crear fase y cargar partidos</button>
    </form>
</div>

@section Scripts {
<script>
function validateFile(input, maxMB, errId, hintId) {
    const errEl  = document.getElementById(errId);
    const hintEl = document.getElementById(hintId);
    errEl.textContent = '';
    if (!input.files || input.files.length === 0) return true;
    const file = input.files[0];
    if (file.size > maxMB * 1024 * 1024) {
        errEl.textContent = `El archivo supera el máximo de ${maxMB} MB.`;
        input.value = ''; return false;
    }
    hintEl.textContent = `✓ ${file.name} (${(file.size/1024/1024).toFixed(2)} MB)`;
    hintEl.style.color = 'var(--green)';
    return true;
}
</script>
}
